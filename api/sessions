[{"id": "2026-07-26_china-rockets-ev-playbook", "date": "2026-07-26", "categories": ["技術・AI", "地政学"], "news": {"source": "Bloomberg", "headline": "スペースXを猛追する中国ロケット勢に要注意－宇宙でもEV産業と同じ構図に", "source_url": "https://www.bloomberg.com/jp/news/articles/2026-07-26/TI5EJLT96OSG00?srnd=jp-homepage", "essence": "スペースXを追う中国ロケット勢。記事はこれを『EV産業と同じ構図』と呼ぶ。EVで起きたことをロケットに置き換えると何が見えるか——ただし宇宙には、EVと決定的に違う条件が一つある。それが連想の分かれ目。"}, "calls": [{"ticker": "464A.T", "name": "QPSホールディングス", "direction": "+", "basis": "打ち上げは衛星事業者にとって仕入れコスト。世界的な打ち上げ供給増と価格低下の受益側"}, {"ticker": "7013.T", "name": "IHI", "direction": "+", "basis": "中国の宇宙能力急伸への警戒は日米の安保宇宙・防衛予算の拡大要因。官需の受益側", "price_at_call": 2878.5, "called_at": "2026-07-26"}, {"ticker": "RKLB", "name": "Rocket Lab", "direction": "-", "basis": "商業打ち上げの価格競争激化の直撃側。低価格の中国勢と再使用のスペースXに挟まれる中堅事業者", "price_at_call": 63.91, "called_at": "2026-07-26"}], "questions": [{"step": "① 本質を掴む", "q": "『EV産業と同じ構図』という表現の本質として最も筋が良いのはどれ？（どれももっともらしい）", "options": ["EVの『国家支援×量産×価格競争』がロケットに移植される", "中国のロケット技術がスペースXを既に追い抜いたという逆転の話", "米中の宇宙軍拡競争が始まったという安全保障だけの話", "スペースXの打ち上げ失敗が増えている個社の経営問題の話"], "correct": 0, "reason": "本命は{A}。EVで中国が世界を席巻した手順——国家支援で多数の企業を育て、量産でコストを崩し、価格競争で淘汰しながら残った勝者が輸出攻勢に出る——がロケット産業で再現されつつある、というのがこの記事の警告。{B}は時制の飛躍で、『猛追』は逆転ではない（技術・実績ともスペースXが依然先行）。{C}は経路として絡むが、記事の主題は軍拡でなく産業構造の複製。{D}は書かれていない事実の捏造。『〜と同じ構図』という比喩が出たら、元の産業で何が起きたかを手順として書き出し、どこまで写像できるかを確かめるのが本質の掴み方。", "glossary": [{"t": "プレイブック", "d": "勝ちパターンの手順書。EVで使った国家支援×量産×価格競争の型。"}, {"t": "量産体制", "d": "大量生産でコストを下げる仕組み。EV型プレイブックの心臓部。"}, {"t": "構造破壊", "d": "コストの前提そのものを崩すこと。"}]}, {"step": "② 一次影響（＋）", "q": "打ち上げ供給の増加とコスト低下で、最も素直に受益するのはどれ？", "options": ["打ち上げ事業者の全体（市場拡大の恩恵を等しく受ける）", "打ち上げ保険会社（打ち上げ回数増で契約が増える）", "衛星を打ち上げる側（打ち上げは彼らの仕入れコスト）", "ロケット燃料の供給会社（打ち上げ増で燃料需要拡大）"], "correct": 2, "reason": "供給が増えて価格が下がる財の受益者は、それを『仕入れる側』。衛星事業者にとって打ち上げ費用は最大級のコスト項目で、その低下は採算ラインの改善に直結する。{A}が一括りの罠——市場全体は拡大しても、供給増は価格決定力の低下でもあり、事業者間で勝敗が激しく割れる（次問）。{B}は件数増と単価下落・競争激化が相殺し、素直な受益とは言えない。{D}は規模感の破綻で、燃料は打ち上げコストのごく一部にすぎない。コスト破壊のニュースは『作る側』でなく『買う側』から受益者を探す。", "glossary": [{"t": "コンステレーション", "d": "多数の衛星を連携させて運用する仕組み。建設が需要を生む。"}, {"t": "仕入れコスト", "d": "打ち上げ費用は衛星事業者にとっての仕入れ。低下で採算が改善。"}]}, {"step": "③ 一次影響（−）", "q": "価格競争の激化で最も逆風を受けやすいのはどれ？（首位が最も痛むとは限らない）", "options": ["首位のスペースX（追われる立場で最も失うものが大きい）", "政府主導で高コストな中堅の打ち上げ勢（欧州・日本など）", "衛星の運営者（打ち上げ価格の下落で衛星価値も下がる）", "宇宙向け部品メーカー（打ち上げ価格下落で部品単価も低下）"], "correct": 1, "reason": "{A}が直感の罠——価格競争で最初に痛むのは首位ではなく、コスト競争力のない二番手以下。スペースXは再使用で業界最低水準のコストを持ち、価格勝負ではむしろ守られる側。本当に苦しいのは、再使用も量産もないまま政府予算で成り立ってきた高コストの中堅勢で、商業受注の場で上と下から挟まれる。{C}は符号反転で、打ち上げ価格の低下は衛星事業者の仕入れコスト低下＝受益。{D}は逆で、打ち上げ回数の増加は部品需要の拡大＝追い風側。価格破壊の逆風は『首位』でなく『高コストの中間層』に最初に来る——EVで起きたことと同じ。", "glossary": [{"t": "再使用", "d": "ロケットを回収して再び使う技術。コストを大きく下げる。"}, {"t": "中堅打ち上げ勢", "d": "再使用も量産もない高コストの二番手。上下から挟まれる側。"}]}, {"step": "④ 二次影響（本番）", "q": "二次波及として最も筋が良いのはどれ？（3つは符号か規模感が破綻している）", "options": ["打ち上げ増で衛星保険料が急落し大手保険会社が経営危機に", "打ち上げコストの低下で衛星の製造価格がむしろ上昇する", "中国の打ち上げ増を受け世界各国が宇宙予算を削減する", "打ち上げ安でコンステ建設が加速し部品・防衛需要が拡大"], "correct": 3, "reason": "本命は{D}の二段構え。第一の経路は商業面——打ち上げが安くなるほど、これまで採算に乗らなかった衛星ビジネスが成立し、コンステレーション建設が加速する。需要は打ち上げの川上（部品・地上局）と、衛星が使う希少資源（軌道・周波数枠）の争奪に波及する。第二の経路は安保面——中国の打ち上げ能力の急伸は西側の警戒を招き、官需宇宙・防衛予算はむしろ拡大方向に働く。{A}は規模感の破綻（宇宙保険は保険市場全体のごく一部）。{B}は符号がつながらない。{C}は反応の向きが逆——脅威の顕在化は予算を増やす。コスト破壊の二次影響は『新たに採算に乗る需要』と『警戒する側の対抗予算』の二方向で追う。", "glossary": [{"t": "採算ライン", "d": "利益が出る損益分岐の水準。打ち上げ安で下がり需要が増える。"}, {"t": "地上インフラ", "d": "衛星と通信する地上局など。コンステ建設で需要が波及。"}, {"t": "官需", "d": "政府・防衛の需要。脅威の顕在化でむしろ拡大する。"}]}, {"step": "⑤ 逆シナリオ", "q": "『宇宙でもEVと同じことが起きる』という連想が崩れる条件として最も筋が良いのは？（EVとの違いが急所）", "options": ["ロケットは安保物資ゆえ輸出規制で市場が分断される", "中国政府が宇宙企業への支援をこの先さらに拡大する", "スペースXが値下げと打ち上げ頻度の引き上げで応戦", "世界の衛星通信需要が想定よりも速く伸びていく"], "correct": 0, "reason": "EVとロケットの決定的な違いは『輸出できるか』。EVは普通の商品として世界中に売れたからコスト優位が席巻につながったが、ロケットは安保物資でありミサイル技術と地続きのため、西側の衛星が中国のロケットで打ち上がることは規制上ほぼない。市場が分断されれば、中国勢がいくら安くても価格競争は中国圏の内側に閉じ、『同じ構図』の写像はそこで途切れる——これが{A}で、連想の土台を直接抜く。{B}と{C}は順張りで、支援拡大も値下げ応戦も価格破壊の構図をむしろ強める。{D}は需要の話で構図を壊さない。比喩の連想は『元の産業と決定的に違う条件』を探すのが崩し方の定石。", "glossary": [{"t": "安保物資", "d": "安全保障に関わる物資。ミサイル技術と地続きで輸出が規制される。"}, {"t